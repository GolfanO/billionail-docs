<script>
	function calculatePoints() {
		const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
		const isFree = (document.getElementById('calc-is-free') as HTMLInputElement | null)?.checked;
		const isPackage = (document.getElementById('calc-is-package') as HTMLInputElement | null)?.checked;
		const pointsDisplay = document.getElementById('calc-points');
		const explainDisplay = document.getElementById('calc-explain');
		if (!amountInput || !pointsDisplay || !explainDisplay) return;

		const amount = Math.max(0, parseFloat(amountInput.value) || 0);

		if (isFree) {
			pointsDisplay.textContent = '0 แต้ม';
			explainDisplay.textContent = 'บริการแลกฟรี (ราคา 0 บาท) จะไม่ได้รับแต้มสะสมค่ะ';
			return;
		}
		if (isPackage) {
			pointsDisplay.textContent = '0 แต้ม';
			explainDisplay.textContent = 'การซื้อแพ็กเกจ / เครดิตล่วงหน้า จะไม่นับแต้มในระบบนี้ค่ะ';
			return;
		}

		const points = Math.floor(amount / 400);
		const remainder = amount % 400;
		pointsDisplay.textContent = `${points} แต้ม`;
		if (points === 0) {
			explainDisplay.textContent = `ยอด ฿${amount.toLocaleString()} ยังไม่ถึง 400 บาท (ขาดอีก ฿${(400 - remainder).toLocaleString()} จะได้ 1 แต้ม)`;
		} else {
			explainDisplay.textContent = `ยอด ฿${amount.toLocaleString()} = ได้ ${points} แต้ม (เศษ ฿${remainder.toLocaleString()} ปัดทิ้ง)`;
		}
	}

	document.getElementById('calc-amount')?.addEventListener('input', calculatePoints);
	document.getElementById('calc-is-free')?.addEventListener('change', calculatePoints);
	document.getElementById('calc-is-package')?.addEventListener('change', calculatePoints);
	document.querySelectorAll<HTMLButtonElement>('[data-amt]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const input = document.getElementById('calc-amount') as HTMLInputElement | null;
			if (!input) return;
			input.value = btn.dataset.amt || '0';
			calculatePoints();
		});
	});
	calculatePoints();
</script>
