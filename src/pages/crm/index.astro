---
import GuideLayout from '../../layouts/GuideLayout.astro';

const tabs = [
	{ href: '#rules-summary', label: '📌 สรุปกฎ 3 ข้อ' },
	{ href: '#earn-points', label: '1. ได้แต้มยังไง' },
	{ href: '#redeem-points', label: '2. วิธีแลกแต้ม' },
	{ href: '#link-line', label: '3. วิธีผูก LINE' },
	{ href: '#prohibitions', label: '4. ข้อห้ามสำคัญ' },
	{ href: '#faq', label: '5. ถามบ่อย (FAQ)' },
	{ href: '#calculator', label: '🧮 เครื่องคิดแต้ม', accent: 'amber' as const },
];
---

<GuideLayout
	title="คู่มือแคชเชียร์ BillioNail — ระบบสะสมแต้ม"
	description="คู่มือแคชเชียร์ระบบสะสมแต้ม BillioNail — ใส่เบอร์ ปิดบิล แลกรางวัลที่เคาน์เตอร์"
	heading="คู่มือแคชเชียร์ — ระบบสะสมแต้ม"
	current="crm"
	tabs={tabs}
>
	<section class="hero">
		<span class="hero__badge">✨ อ่านจบใน 3 นาที เข้าใจพร้อมคิดเงินทันที</span>
		<h2>ระบบสะสมแต้ม BillioNail</h2>
		<p>
			จำง่ายๆ แค่ <strong>"เบอร์โทรตรง = แต้มเข้าชัวร์"</strong> ลูกค้าได้แต้มอัตโนมัติ
			ส่วนการแลกของรางวัล <strong>ลูกค้าแลกเองในมือถือไม่ได้ ต้องมาทำที่เคาน์เตอร์กับแคชเชียร์เท่านั้นค่ะ!</strong>
		</p>
		<span class="hero__mark" aria-hidden="true">💎</span>
	</section>

	<section id="rules-summary" class="grid grid-3">
		<div class="card">
			<div>
				<div class="icon-box">1</div>
				<h3>ใส่เบอร์ให้ถูก = แต้มเข้าเลย</h3>
				<p>แต้มทั้งหมดผูกติดกับ <strong>"เบอร์โทร"</strong> คิดเงินเสร็จระบบคำนวณแต้มให้ทันที ไม่ต้องกดอะไรเพิ่ม</p>
			</div>
			<div class="card-foot">🎯 400 บาท = 1 แต้ม (ปัดเศษทิ้ง)</div>
		</div>
		<div class="card amber">
			<div>
				<div class="icon-box amber">2</div>
				<h3>แลกแต้มที่เคาน์เตอร์เท่านั้น</h3>
				<p>
					ลูกค้าเปิดดูแต้มใน LINE ได้ <strong>แต่กดแลกเองไม่ได้</strong> ต้องบอกเบอร์ให้แคชเชียร์กดปุ่ม
					<strong>แลกรางวัล</strong> ใน POS ให้เท่านั้น
				</p>
			</div>
			<div class="card-foot amber">🎁 แลกได้สูงสุดวันละ 2 ครั้ง / เบอร์ · ครั้งละ 1 รายการ</div>
		</div>
		<div class="card emerald">
			<div>
				<div class="icon-box emerald">3</div>
				<h3>เบอร์ผิดห้ามสมัครซ้ำ</h3>
				<p>
					ถ้าพิมพ์เบอร์ผิด หรือลูกค้าเปลี่ยนเบอร์ <strong>อย่ากดสร้างลูกค้าใหม่</strong> ให้ส่งแจ้งแอดมินแก้ในระบบ CRM
				</p>
			</div>
			<div class="card-foot emerald">⚠️ เลิกใช้ MyCustomer แล้ว ใช้ POS ตัวเดียว</div>
		</div>
	</section>

	<section class="compare">
		<h3>⚠️ อย่าสับสนสองอย่างนี้ตอนคิดเงิน</h3>
		<div class="split">
			<div class="pink">
				<div class="label">แลกแต้ม</div>
				<p>
					<strong>แลกแต้ม = ปุ่มแลกรางวัลเท่านั้น</strong><br />
					กดปุ่ม <strong>แลกรางวัล</strong> บนการ์ดสะสมแต้ม แล้วเลือกของรางวัล ระบบจะตัดแต้มให้บริการฟรี (฿0)
				</p>
			</div>
			<div>
				<div class="label">Credit · แพ็กเกจ</div>
				<p>
					<strong>Credit / แพ็กเกจ = ใช้แพ็กเกจล่วงหน้า ไม่หักแต้ม</strong><br />
					คือวิธีชำระด้วยเครดิตหรือแพ็กเกจที่ลูกค้าซื้อไว้ (จอชำระเงินอาจเคยเขียนว่า <em>Member</em>) —
					<strong>ไม่ใช่การแลกแต้ม</strong> ค่ะ
				</p>
			</div>
		</div>
		<p class="note">
			จำสั้นๆ: อยากตัดแต้มให้ลูกค้าใช้บริการฟรี → กด <strong>แลกรางวัล</strong> เท่านั้น อย่าเลือก Credit /
			แพ็กเกจ / Member แทน · วิธีใช้เครดิตอ่านที่ <a href="/credit/">คู่มือเครดิตสมาชิก</a>
		</p>
	</section>

	<section id="earn-points" class="section">
		<div class="section-head">
			<span class="num">1</span>
			<div>
				<h2>ลูกค้าจะได้แต้มยังไง? (การสะสมแต้ม)</h2>
				<p>ง่ายมาก แค่ใส่เบอร์ ปิดบิลตามปกติ แต้มคำนวณให้อัตโนมัติ</p>
			</div>
		</div>
		<div class="grid grid-2">
			<div class="panel">
				<h4>📱 ขั้นตอนการคิดเงิน</h4>
				<ol class="steps">
					<li>ใส่ <strong>เบอร์โทรศัพท์ลูกค้า</strong> ในบิลให้ถูกต้อง</li>
					<li>คิดค่าบริการตามปกติ</li>
					<li>กด <strong>"ชำระเงิน"</strong> ปิดบิลเรียบร้อย แต้มจะเข้าทันที</li>
				</ol>
			</div>
			<div class="panel emerald">
				<h4>💬 สรุปบิลเด้งเข้า LINE อัตโนมัติ</h4>
				<p>
					ถ้าลูกค้าผูก LINE ร้านไว้แล้ว พอเรากดปิดบิลเสร็จปุ๊บ ระบบจะส่ง
					<strong>การ์ดสรุปบิลสองภาษา (ไทย/อังกฤษ)</strong> ยอดเงิน + แต้มสะสม เข้า LINE ลูกค้าอัตโนมัติทันที
					แคชเชียร์ไม่ต้องทำอะไรเพิ่มเลยค่ะ!
				</p>
			</div>
		</div>
		<div class="panel slate" style="margin-top: 0.85rem">
			<div class="formula">
				<span>💰 สูตรการคิดแต้ม (จำง่ายๆ)</span>
				<span class="chip">ทุก 400 บาทสุทธิ = 1 แต้ม (ปัดเศษทิ้ง)</span>
			</div>
			<p class="lede" style="margin-bottom: 0.7rem">
				คิดจากยอดชำระจริง <strong>"หลังหักส่วนลดทั้งหมดแล้ว"</strong> เท่านั้น
			</p>
			<div class="stat-grid">
				<div class="stat">
					<small>ยอดจ่ายจริง 750 บ.</small>
					<b>1 แต้ม</b>
					<span>(เศษ 350 บ. ปัดลง)</span>
				</div>
				<div class="stat">
					<small>ยอดจ่ายจริง 800 บ.</small>
					<b>2 แต้ม</b>
					<span>(พอดี 400 × 2)</span>
				</div>
				<div class="stat">
					<small>ยอดจ่ายจริง 1,290 บ.</small>
					<b>3 แต้ม</b>
					<span>(เศษ 90 บ. ปัดลง)</span>
				</div>
			</div>
		</div>
		<div class="panel red" style="margin-top: 0.85rem">
			<h4>❌ 2 สิ่งที่ "ไม่ได้แต้ม"</h4>
			<ul class="clean">
				<li>
					<strong>บริการที่ใช้แต้มแลกฟรี (ราคา ฿0):</strong> เฉพาะตัวรายการแลกฟรีจะไม่ได้แต้มเพิ่ม
					(แต่ถ้ามีบริการอื่นที่จ่ายเงินในบิลเดียวกัน ส่วนที่จ่ายเงินยังได้แต้มปกติ)
				</li>
				<li>
					<strong>บิลซื้อเครดิต / ซื้อแพ็กเกจล่วงหน้า:</strong> ซื้อคอร์สหรือแพ็กเกจ (ชำระแบบ Credit /
					แพ็กเกจ) จะไม่นับแต้ม — ดู <a href="/credit/">คู่มือเครดิต</a>
				</li>
			</ul>
		</div>
	</section>

	<section id="redeem-points" class="section">
		<div class="section-head">
			<span class="num amber">2</span>
			<div>
				<div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.45rem">
					<h2>การแลกแต้มของรางวัล</h2>
					<span class="chip">ทำที่เคาน์เตอร์เท่านั้น</span>
				</div>
				<p>
					ลูกค้าเปิดดูแต้มใน LINE ได้ แต่ถ้าจะแลก ต้องให้แคชเชียร์กดปุ่ม <strong>แลกรางวัล</strong> ใน POS
					เท่านั้น — ไม่มีแลกเองใน LINE และไม่ใช้ MyCustomer
				</p>
			</div>
		</div>

		<div class="panel">
			<h4>🛠️ 4 สเต็ปกดแลกแต้มใน POS (จอคิดเงินปัจจุบัน)</h4>
			<div class="grid grid-4">
				<div class="card">
					<h3>สเต็ป 1: ใส่เบอร์โทร</h3>
					<p>พิมพ์เบอร์ลูกค้าในช่องเบอร์โทรบนบิล ระบบจะโชว์การ์ดสะสมแต้มทันที</p>
				</div>
				<div class="card">
					<h3>สเต็ป 2: ดูแต้มบนการ์ด</h3>
					<p>ดูการ์ดสะสมแต้ม (โทนชมพูร้าน) ว่ามีแต้มพอไหม และ <strong>แลกวันนี้ x/2</strong> ยังไม่เต็มโควตา</p>
				</div>
				<div class="card">
					<h3>สเต็ป 3: กด [แลกรางวัล]</h3>
					<p>กดปุ่ม <strong>แลกรางวัล</strong> เลือกของรางวัล — ถ้าเป็นตัดหนังหรือทาสีเจล ให้เลือก <strong>มือ หรือ เท้า</strong> ด้วย</p>
				</div>
				<div class="card">
					<h3>สเต็ป 4: ปิดบิลรายการฟรี</h3>
					<p>รายการฟรี <strong>฿0</strong> จะเข้าบิล แล้วกดชำระเงินตามปกติ (อย่าเลือก Credit / แพ็กเกจ แทนการแลกแต้ม)</p>
				</div>
			</div>
		</div>

		<div style="margin-top: 1.1rem">
			<div class="formula">
				<span>🎁 ตารางบริการที่แลกแต้มได้ (มี 4 รายการนี้เท่านั้น)</span>
				<span class="muted">แต้มไม่ถึง แลกไม่ได้นะจ๊ะ</span>
			</div>
			<div class="grid grid-4">
				<div class="reward">
					<div>
						<div class="emoji">✂️</div>
						<div class="kind">งานเล็บ</div>
						<h4>ตัดหนัง</h4>
						<p>ตัดหนังมือ หรือ ตัดหนังเท้า — เลือกมือ/เท้าตอนกดแลก</p>
					</div>
					<div class="pts"><span class="muted">ใช้แต้ม</span><b>8 <small>แต้ม</small></b></div>
				</div>
				<div class="reward">
					<div>
						<div class="emoji">💅</div>
						<div class="kind">งานเล็บ</div>
						<h4>ทาสีเจล</h4>
						<p>ทาสีเจลมือ หรือ ทาสีเจลเท้า — เลือกมือ/เท้าตอนกดแลก</p>
					</div>
					<div class="pts"><span class="muted">ใช้แต้ม</span><b>10 <small>แต้ม</small></b></div>
				</div>
				<div class="reward amber">
					<div>
						<div class="emoji">✨</div>
						<div class="kind">งานแว็กซ์</div>
						<h4>แว็กซ์คิ้ว</h4>
						<p>จัดแต่งทรงคิ้วสวยเป๊ะ</p>
					</div>
					<div class="pts"><span class="muted">ใช้แต้ม</span><b>10 <small>แต้ม</small></b></div>
				</div>
				<div class="reward purple">
					<div>
						<div class="emoji">👁️</div>
						<div class="kind">งานขนตา</div>
						<h4>ต่อขนตา</h4>
						<p>เฉพาะทรง 3D / 6D / 15D เท่านั้น</p>
					</div>
					<div class="pts"><span class="muted">ใช้แต้ม</span><b>50 <small>แต้ม</small></b></div>
				</div>
			</div>
		</div>

		<div class="alert" style="margin-top: 1.1rem">
			<h4>🛑 กฎเหล็กการแลกแต้ม (ห้ามลืมเด็ดขาด!)</h4>
			<div class="grid grid-3">
				<div class="card soft-red">
					<h3>❌ ขนตาที่ห้ามแลก</h3>
					<p>ห้ามแลก <strong>Mega Volume</strong>, <strong>เติมขนตา</strong> และ <strong>ลิฟท์ติ้ง</strong> ขนตา/คิ้ว ทุกกรณี!</p>
				</div>
				<div class="card soft-red">
					<h3>❌ ห้ามซ้อนโปร/ส่วนลด</h3>
					<p>บิลที่มีรายการแลกแต้ม <strong>ไม่สามารถใส่ส่วนลดหรือโปรโมชั่นอื่นได้</strong> (ระบบล็อกให้อัตโนมัติ)</p>
				</div>
				<div class="card soft-red">
					<h3>⏱️ โควตาต่อวัน</h3>
					<p>1 เบอร์แลกได้สูงสุด <strong>ไม่เกิน 2 ครั้ง/วัน</strong> และทำรายการได้ <strong>ครั้งละ 1 รายการ</strong></p>
				</div>
			</div>
		</div>

		<div class="panel slate" style="margin-top: 1.1rem">
			<div class="formula">
				<span>🖥️ จอ POS ปัจจุบัน: การ์ดสะสมแต้ม + หน้าต่างแลกรางวัล</span>
				<span class="muted">แตะรูปเพื่อขยายใหญ่</span>
			</div>
			<p class="lede" style="margin-bottom: 0.85rem">
				📌 <strong>จอปัจจุบัน:</strong> แต้มและโควตาอยู่บน <strong>การ์ดสะสมแต้มโทนชมพูร้าน</strong>
				(แต้มคงเหลือ + <code>แลกวันนี้ x/2</code> + ปุ่ม <strong>แลกรางวัล</strong>) —
				<strong>ไม่มีกล่องสีเหลืองให้หาแล้วค่ะ</strong>
			</p>
			<div class="grid grid-2">
				<figure class="shot">
					<button
						type="button"
						data-lightbox
						data-src="/images/crm/screen-loyalty-card.png"
						data-title="การ์ดสะสมแต้มในจอ POS — แต้มคงเหลือ, แลกวันนี้, ปุ่มแลกรางวัล และสร้างรหัส LINE"
					>
						<img
							src="/images/crm/screen-loyalty-card.png"
							width="475"
							height="950"
							alt="จอ POS หลังใส่เบอร์ โชว์การ์ดสะสมแต้มโทนชมพู แต้มคงเหลือ และปุ่มแลกรางวัล"
						/>
					</button>
					<figcaption>
						สเต็ป 1–2: การ์ดชมพูหลังใส่เบอร์ — แต้มคงเหลือ + แลกวันนี้ + ปุ่มแลกรางวัล · ช่อง Member
						ด้านล่าง = Credit / แพ็กเกจ (ไม่หักแต้ม)
					</figcaption>
				</figure>
				<figure class="shot">
					<button
						type="button"
						data-lightbox
						data-src="/images/crm/screen-redeem.png"
						data-title="หน้าต่างแลกรางวัลด้วยแต้ม — เลือกตัดหนังมือหรือเท้า แล้วกดใส่บริการฟรีในบิล"
					>
						<img
							src="/images/crm/screen-redeem.png"
							width="499"
							height="1094"
							alt="หน้าต่างแลกรางวัลด้วยแต้ม เลือกตัดหนังมือหรือเท้า แล้วกดใส่บริการฟรีในบิล"
						/>
					</button>
					<figcaption>
						สเต็ป 3–4: เลือกของรางวัล (ตัดหนัง/ทาสีเจลเลือกมือหรือเท้า) แล้วกดใส่บริการฟรีในบิล
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<section id="link-line" class="section">
		<div class="section-head">
			<span class="num emerald">3</span>
			<div>
				<h2>วิธีช่วยลูกค้า "ผูก LINE" (ทำครั้งเดียวจบ)</h2>
				<p>ผูก LINE แล้ว ลูกค้าดูแต้ม + ประวัติได้เอง และหลังปิดบิลจะได้การ์ดสรุปบิลสองภาษา</p>
			</div>
		</div>
		<div class="grid grid-2">
			<div class="card soft-emerald">
				<div style="margin-bottom: 0.45rem">
					<span class="line-ok">LINE ✓</span>
					<strong> ถ้าขึ้นแบบนี้: แปลว่า "ผูกแล้ว"</strong>
				</div>
				<p>ไม่ต้องทำอะไรเพิ่ม คิดเงินได้ตามปกติเลย หลังคิดเงินบิลจะเด้งเข้า LINE ลูกค้าเองอัตโนมัติ</p>
			</div>
			<div class="card sky">
				<div style="margin-bottom: 0.45rem">
					<span class="line-wait">ยังไม่ผูก LINE</span>
					<strong> ถ้ายังไม่ขึ้น LINE ✓</strong>
				</div>
				<p>
