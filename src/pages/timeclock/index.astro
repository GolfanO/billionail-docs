---
import GuideLayout from '../../layouts/GuideLayout.astro';

const tabs = [
	{ href: '#remember', label: '📌 จำ 3 ข้อ' },
	{ href: '#open', label: '1. เข้าหน้าลงเวลา' },
	{ href: '#gps', label: '2. GPS / ในร้าน' },
	{ href: '#clock-in', label: '3. เข้างาน' },
	{ href: '#outside', label: '4. นอกวง GPS' },
	{ href: '#break', label: '5. พักเบรก' },
	{ href: '#clock-out', label: '6. ออกงาน' },
	{ href: '#dont', label: '7. ข้อควรระวัง' },
	{ href: '#faq', label: '8. FAQ' },
];
---

<GuideLayout
	title="คู่มือพนักงาน BillioNail — การลงเวลาทำงาน (Time Clock)"
	description="คู่มือลงเวลาพนักงาน BillioNail — เข้างาน ออกงาน พักเบรก ผ่าน POS ที่ pos.billionail.com/time-clock"
	heading="คู่มือพนักงาน — ลงเวลาทำงาน"
	current="timeclock"
	tabs={tabs}
>
	<section class="hero">
		<span class="hero__badge">✨ อ่านจบใน 3 นาที พร้อมกดลงเวลาได้ทันที</span>
		<h2>คู่มือลงเวลาทำงาน (Time Clock)</h2>
		<p>
			<strong>ช่องทางลงเวลา:</strong> เข้าผ่านระบบ POS เท่านั้น โดยล็อกอินด้วยบัญชี Google ของตัวเอง
			แล้วไปที่เมนู <strong>"ลงเวลา"</strong> หรือเข้าลิงก์
			<code>https://pos.billionail.com/time-clock</code>
			<br />
			<em>(สาขาที่เปิดให้ลงเวลา: Central / Samkong / Chalong)</em>
		</p>
		<span class="hero__mark" aria-hidden="true">⏰</span>
	</section>

	<section id="remember" class="grid grid-3">
		<div class="card">
			<div>
				<div class="icon-box">1</div>
				<h3>เข้าผ่าน POS เท่านั้น</h3>
				<p>
					ล็อกอินบัญชี Google ของตัวเองในระบบ POS แล้วเปิดหน้าลงเวลา
					<strong>(ไม่มีแอปลงเวลาแยก)</strong>
				</p>
			</div>
			<div class="card-foot">📱 ไม่มีแอป / โดเมน staff แยก</div>
		</div>
		<div class="card amber">
			<div>
				<div class="icon-box amber">2</div>
				<h3>เปิด GPS แล้วยืนในร้าน</h3>
				<p>
					ถ้ายืนอยู่ในรัศมีร้าน กดปุ่มแล้วระบบจะบันทึกทันที สะดวกรวดเร็ว
					<strong>ไม่ต้องรออนุมัติ</strong>
				</p>
			</div>
			<div class="card-foot amber">📍 ในรัศมี = ลงเวลาได้เลย</div>
		</div>
		<div class="card emerald">
			<div>
				<div class="icon-box emerald">3</div>
				<h3>อยู่นอกร้าน = ต้องถ่ายรูป</h3>
				<p>
					ถ้าจำเป็นต้องลงเวลานอกร้าน ระบบจะให้ถ่ายรูปเพื่อยืนยันตัวตน
					และต้องรอให้ผู้จัดการกดอนุมัติก่อน
				</p>
			</div>
			<div class="card-foot emerald">📷 อย่าปิดกล้อง / อย่าส่งรูปเก่า</div>
		</div>
	</section>

	<section id="open" class="section">
		<div class="section-head">
			<span class="num">1</span>
			<div>
				<h2>วิธีเข้าหน้าลงเวลา</h2>
				<p>พนักงานทุกคนสามารถเข้าลงเวลาจากมือถือของตัวเอง หรือแท็บเล็ตประจำหน้าร้านได้เลย</p>
			</div>
		</div>
		<div class="grid grid-2">
			<div class="panel">
				<h4>📱 ขั้นตอนการเข้าใช้งาน</h4>
				<ol class="steps">
					<li>
						เปิดเบราว์เซอร์ (Safari หรือ Chrome) เข้าไปที่ <strong>pos.billionail.com</strong>
					</li>
					<li>
						ล็อกอินด้วย <strong>อีเมล Google ของตัวเอง</strong>
						<em>(ห้ามใช้บัญชีของเพื่อนร่วมงานโดยเด็ดขาด)</em>
					</li>
					<li>
						กดเลือกเมนู <strong>"ลงเวลาทำงาน"</strong> หรือเข้าตรงผ่านลิงก์
						<code>https://pos.billionail.com/time-clock</code>
					</li>
					<li>
						ตรวจสอบและเลือกสาขาที่เข้าทำงานให้ถูกต้อง:
						<strong>Central / Samkong / Chalong</strong>
					</li>
				</ol>
			</div>
			<div class="panel sky">
				<h4>🖥️ หน้าจอจะแสดงข้อมูลดังนี้</h4>
				<ul class="clean">
					<li>แผนที่และวงแสดงรัศมีพิกัดของสาขา</li>
					<li>ปุ่มวงกลมขนาดใหญ่ตรงกลางสำหรับกดลงเวลา</li>
					<li>แถบแสดงสถานะ GPS <em>(บอกว่าจับสัญญาณได้แล้ว หรืออยู่นอกพื้นที่ร้าน)</em></li>
				</ul>
				<p class="lede" style="margin-top: 0.7rem; margin-bottom: 0">
					📷 แคปจอยังไม่มีในคู่มือนี้ — จะใส่ทีหลังเมื่อมีรูปจริง
				</p>
			</div>
		</div>
	</section>

	<section id="gps" class="section">
		<div class="section-head">
			<span class="num amber">2</span>
			<div>
				<h2>การเปิด GPS และลงเวลาในร้าน</h2>
				<p>เพื่อความสะดวกและรวดเร็ว แนะนำให้กดลงเวลาขณะอยู่ในร้านเป็นหลัก</p>
			</div>
		</div>
		<div class="panel">
			<h4>📍 วิธีเปิดพิกัด</h4>
			<ol class="steps">
				<li>
					เมื่อเปิดหน้าเว็บแล้วมีข้อความแจ้งเตือน ให้กด <strong>"อนุญาต" (Allow)</strong>
					เพื่อให้เบราว์เซอร์เข้าถึงตำแหน่งได้
				</li>
				<li>ยืนบริเวณเคาน์เตอร์หรือภายในร้าน รอให้แถบสถานะ GPS แสดงว่าอยู่ในพื้นที่สาขา</li>
				<li>ตรวจดูในแผนที่ว่าจุดตำแหน่งของเราอยู่ในวงสีชมพูของร้านเรียบร้อยแล้ว</li>
				<li>
					<strong>กดปุ่มวงกลมใหญ่เพื่อลงเวลาได้ทันที</strong> — ไม่ต้องถ่ายรูป
					และระบบจะบันทึกเวลาให้ทันทีโดยไม่ต้องรออนุมัติ
				</li>
			</ol>
		</div>
		<div class="panel emerald" style="margin-top: 0.85rem">
			<h4>💡 TIP: หากระบบแจ้งว่าหาพิกัดไม่เจอ</h4>
			<p>
				ตรวจเช็กว่าเปิด Location ในมือถือแล้วหรือยัง และตั้งค่าให้เบราว์เซอร์เข้าถึงตำแหน่งได้
				จากนั้นลองกดรีเฟรชหน้าเว็บอีกครั้ง
			</p>
		</div>
	</section>

	<section id="clock-in" class="section">
		<div class="section-head">
			<span class="num">3</span>
			<div>
				<h2>การกดเข้างาน (เริ่มกะ)</h2>
				<p>ปุ่มเขียวใหญ่ตรงกลาง — กดเมื่อพร้อมเริ่มกะ</p>
			</div>
		</div>
		<div class="grid grid-2">
			<div class="panel">
				<h4>🟢 ขั้นตอนการเข้างาน</h4>
				<ol class="steps">
					<li>
						ตรวจสอบว่าเลือก <strong>สาขาถูกต้อง</strong> และแถบ GPS ขึ้นว่า
						<strong>อยู่ในร้าน</strong>
					</li>
					<li>กดปุ่มวงกลมสีเขียว <strong>"เข้างาน"</strong> ตรงกลางจอ</li>
					<li>
						เมื่อบันทึกสำเร็จ บนหน้าจอจะขึ้นเวลาที่เข้างาน พร้อมสถานะสีเหลืองว่า
						<strong>"กำลังทำงาน"</strong>
					</li>
				</ol>
			</div>
			<div class="panel slate">
				<h4>สรุปความหมายของสีและปุ่มต่างๆ</h4>
				<ul class="clean">
					<li>
						<strong style="color:#16a34a">สีเขียว (เข้างาน):</strong> กดเมื่อเริ่มทำงานกะของวัน
					</li>
					<li>
						<strong style="color:#0ea5e9">สีฟ้า (พักเบรก):</strong>
						กดเมื่อถึงเวลาพักรับประทานอาหาร / พักระหว่างวัน
					</li>
					<li>
						<strong style="color:#38bdf8">สีฟ้าอ่อน (กลับจากพัก):</strong>
						กดเมื่อพักเสร็จ พร้อมกลับมาปฏิบัติงานต่อ
					</li>
					<li>
						<strong style="color:#dc2626">สีแดง (ออกงาน):</strong> กดเมื่อจบกะการทำงานของวัน
					</li>
					<li>
						<strong style="color:#ea580c">สีส้ม (รออนุมัติ):</strong>
						ลงเวลานอกพื้นที่ กำลังรอให้ผู้จัดการตรวจสอบและกดอนุมัติ
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section id="outside" class="section">
		<div class="section-head">
			<span class="num rose">4</span>
			<div>
				<h2>กรณีอยู่นอกร้าน / นอกวง GPS (ต้องถ่ายรูปยืนยัน)</h2>
				<p>
					หากมีความจำเป็นต้องลงเวลานอกร้าน (เช่น ไปช่วยงานนอกสถานที่ หรือได้รับมอบหมายเป็นกรณีพิเศษ)
					ระบบจะเปลี่ยนขั้นตอนเป็นการถ่ายรูปเพื่อยืนยันตัวตน
				</p>
			</div>
		</div>
		<div class="panel amber">
			<h4>📷 ขั้นตอนการลงเวลานอกร้าน</h4>
			<ol class="steps">
				<li>หากอยู่นอกรัศมีสาขา ระบบจะแจ้งเตือนอัตโนมัติ</li>
				<li>
					กดเปิดกล้องและ <strong>ถ่ายรูปตัวเอง/สถานที่</strong> ตามที่ระบบแนะนำบนหน้าจอ
				</li>
				<li>ตรวจสอบรูปภาพให้ชัดเจน แล้วกด <strong>"ยืนยันรูป"</strong></li>
				<li>กดปุ่มลงเวลาตามปกติ (เข้างาน หรือ ออกงาน)</li>
				<li>
					หน้าจอจะเปลี่ยนสถานะเป็น <strong>"รออนุมัติ" (แถบสีส้ม)</strong>
					ส่งไปให้ผู้จัดการสาขาตรวจสอบ
				</li>
			</ol>
		</div>
		<div class="dark-callout" style="margin-top: 0.9rem">
			<h4>🚨 IMPORTANT: หลังจากส่งคำขอแล้ว</h4>
			<p>
				รอผู้จัดการกดอนุมัติในระบบ — <strong>กดส่งเพียงครั้งเดียว ไม่ต้องกดย้ำซ้ำๆ</strong>
				หากรอนานผิดปกติสามารถทักแจ้งผู้จัดการสาขาได้โดยตรง
			</p>
		</div>
	</section>

	<section id="break" class="section">
		<div class="section-head">
			<span class="num indigo">5</span>
			<div>
				<h2>การกดพักเบรก / กลับจากพัก</h2>
				<p>
					ใช้สำหรับช่วงพักระหว่างวัน เช่น พักทานข้าวกลางวัน
					<em>(ไม่ใช่การกดออกงาน)</em>
				</p>
			</div>
		</div>
		<div class="grid grid-2">
			<div class="card sky">
				<div>
					<div class="icon-box" style="background:#e0f2fe;color:#0369a1">⏸</div>
					<h3>เมื่อเริ่มพัก</h3>
					<p>
						กดปุ่ม <strong>"พักเบรก" (สีฟ้า)</strong>
					</p>
				</div>
				<div class="card-foot">อย่ากดออกงานแทนพัก</div>
			</div>
			<div class="card soft-emerald">
				<div>
					<div class="icon-box emerald">▶</div>
					<h3>เมื่อกลับมาทำงาน</h3>
					<p>
						กดปุ่ม <strong>"กลับจากพัก" (สีฟ้าอ่อน)</strong>
						เพื่อเปลี่ยนสถานะกลับมาเป็นกำลังทำงานตามเดิม
					</p>
				</div>
				<div class="card-foot emerald">ลืมกด = เวลาพักยาวผิดจริง</div>
			</div>
		</div>
	</section>

	<section id="clock-out" class="section">
		<div class="section-head">
			<span class="num rose">6</span>
			<div>
				<h2>การกดออกงาน (เลิกงาน)</h2>
				<p>ปุ่มแดง — กดเมื่อจบกะแล้วเท่านั้น</p>
			</div>
		</div>
		<div class="panel">
			<h4>🔴 ขั้นตอนการออกงาน</h4>
			<ol class="steps">
				<li>เคลียร์งานหน้าร้านให้เรียบร้อย และตรวจดูว่าไม่อยู่ในสถานะพักเบรกค้างไว้</li>
				<li>ยืนในร้าน ตรวจสอบสัญญาณ GPS แล้วกดปุ่มสีแดง <strong>"ออกงาน"</strong></li>
				<li>
					หากอยู่นอกร้าน ให้ทำตามขั้นตอน: ถ่ายรูปยืนยัน ➔ ส่งคำขอ ➔ รอผู้จัดการอนุมัติ
				</li>
				<li>สังเกตหน้าจอว่าระบบบันทึกเวลาออกงานเรียบร้อยแล้ว จึงปิดหน้าเว็บได้</li>
			</ol>
		</div>
		<div class="panel red" style="margin-top: 0.85rem">
			<h4>⚠️ WARNING: หากลืมกดออกงาน</h4>
			<p>
				อย่าปล่อยสถานะทิ้งข้ามวัน ให้รีบทักแจ้งผู้จัดการสาขาทันทีพร้อมระบุเวลาที่เลิกงานจริง
				เพื่อให้ผู้จัดการช่วยปิดกะในระบบให้
				<strong>(พนักงานจะไม่สามารถแก้ไขเวลาเองได้)</strong>
			</p>
		</div>
	</section>

	<section id="dont" class="section">
		<div class="section-head">
			<span class="num rose">7</span>
			<div>
				<h2>ข้อควรระวังที่พนักงานทุกคนต้องทราบ</h2>
				<p>เรื่องที่พนักงานไม่ควรทำเอง และเมื่อไหร่ควรแจ้งผู้จัดการ</p>
			</div>
		</div>
		<div class="alert">
			<h4>🛑 กฎเหล็กลงเวลา</h4>
			<div class="grid grid-3">
				<div class="card soft-red">
					<h3>ห้ามใช้บัญชีของเพื่อนร่วมงาน</h3>
					<p>
						ล็อกอินด้วยอีเมล Google ของตัวเองเท่านั้น ห้ามฝากเพื่อนกดแทน
						หรือกดแทนคนอื่นทุกกรณี
					</p>
				</div>
				<div class="card soft-red">
					<h3>ห้ามปลอมแปลงตำแหน่ง GPS หรือรูปภาพ</h3>
					<p>
						ถ่ายภาพสดจากกล้องตามจริงเท่านั้น ไม่อนุญาตให้ใช้แอปจำลองตำแหน่ง
						หรือใช้รูปเก่าจากอัลบั้ม
					</p>
				</div>
				<div class="card soft-red">
					<h3>ตรวจสอบสาขาให้ถูกต้องทุกครั้ง</h3>
					<p>
						มีเฉพาะ Central, Samkong และ Chalong (ไม่มี Devadiva)
						เลือกให้ตรงกับสาขาที่เข้ากะจริงในวันนั้น
					</p>
				</div>
			</div>
		</div>
		<div class="dark-callout" style="margin-top: 0.9rem">
			<h4>🚨 กรณีที่ต้องติดต่อผู้จัดการ / แอดมิน</h4>
			<ul class="clean">
				<li>ลืมกดออกงาน หรือเผลอกดปุ่มผิด</li>
				<li>สถานะรออนุมัติค้างนานผิดปกติ</li>
				<li>ล็อกอินผิดบัญชี หรือ GPS ไม่จับสัญญาณตลอดทั้งวัน</li>
			</ul>
			<p style="margin-top: 0.6rem; margin-bottom: 0">
				พนักงานไม่มีหน้าอนุมัติ แก้เวลา หรือดูรายชื่อใครอยู่ในระบบ — ส่งเรื่องให้ผู้จัดการจัดการให้
			</p>
		</div>
	</section>

	<section id="faq" class="section">
		<div class="section-head">
			<span class="num indigo">8</span>
			<div>
